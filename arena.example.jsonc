      //   "prompt_assembly": "{{#if context}}Context:\n{{context}}\n\n{{/if}}{{#if system}}{{system}}\n\n{{/if}}{{prompt}}{{#if history}}\n\nPrevious discussion:\n{{history}}{{/if}}",
      //   "history_entry": "[{{agent}}]: {{content}}"
      // }
    }
  },
  "scenarios": {}
}
