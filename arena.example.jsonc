// Copy this file to .arena.jsonc (project root) or ~/.config/arena/config.jsonc and customize.
// All fields are optional — only include what you want to override.
{
  "version": 1,
  "defaults": {
    "models": {
      // Override the model string for an official built-in adapter.
      // "claude": { "model": "claude-opus-4-7" },

      // --- Custom adapter examples ---
      // Add any adapter not included in the built-in defaults by defining it here.
      // The adapter will be registered and available in all scenarios.

      // Example: GLM via opencode binary (stdout output)
      // "glm": {
      //   "enabled": true,
      //   "bin": "opencode",
      //   "model": "zhipuai/glm-5.1",
      //   "command": {
      //     "args": [
      //       "{{bin}}", "run",
